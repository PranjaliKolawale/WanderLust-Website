<% layout("/layouts/boilerplate") -%>
<h2 class="mt-4">Admin Panel</h2>
<%- include("../includes/adminNav.ejs", { active: "users" }) %>

<h5>All users (<%= users.length %>)</h5>
<div class="table-responsive">
<table class="table admin-table">
    <thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Listings</th><th>Reviews</th><th></th></tr></thead>
    <tbody>
    <% users.forEach(u => { const isMe = u._id.equals(currUser._id); %>
        <tr>
            <td><%= u.username %> <% if(isMe){ %><small class="text-muted">(you)</small><% } %></td>
            <td><%= u.email %></td>
            <td><%= u.isAdmin ? "Admin" : "User" %></td>
            <td><%= listingsBy[u._id.toString()] || 0 %></td>
            <td><%= reviewsBy[u._id.toString()] || 0 %></td>
            <td class="text-end text-nowrap">
                <% if(!isMe){ %>
                <form class="d-inline" method="POST" action="/admin/users/<%= u._id %>/admin?_method=PATCH">
                    <button class="btn btn-sm btn-outline-dark"><%= u.isAdmin ? "Remove admin" : "Make admin" %></button>
                </form>
                <form class="d-inline" method="POST" action="/admin/users/<%= u._id %>?_method=DELETE"
                      onsubmit="return confirm('Delete this user AND all their listings and reviews?')">
                    <button class="btn btn-sm btn-danger">Delete</button>
                </form>
                <% } %>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
</div>
